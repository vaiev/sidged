{
  "category": "plan",
  "description": "SDG-L3 plan verification: effects, data-flow labels, bounded map, approvals, and cost.",
  "vectors": [
    {
      "id": "plan.verify.001",
      "spec": [{ "doc": "L3", "version": "0.1", "section": "R7" }],
      "operation": "plan-check",
      "input": {
        "catalog": [
          {
            "id": "urn:sidged:capability:calendar.free_slots",
            "effects": ["read"],
            "data_classes": ["calendar.availability"],
            "consequential": false,
            "cost": { "class": "free" }
          },
          {
            "id": "urn:sidged:capability:message.send",
            "effects": ["egress"],
            "data_classes": ["communications.content"],
            "consequential": true,
            "cost": { "class": "free" }
          }
        ],
        "plan": {
          "v": "0.1",
          "goal": "Propose a time",
          "budget": { "max": { "amount": "0.01", "currency": "CHF" } },
          "steps": [
            {
              "id": "free",
              "kind": "call",
              "capability": "urn:sidged:capability:calendar.free_slots",
              "args": { "range": { "lit": "next_week" } }
            },
            { "id": "pick", "kind": "expr", "expr": "free.slots" },
            {
              "id": "send",
              "kind": "call",
              "capability": "urn:sidged:capability:message.send",
              "approval": true,
              "args": { "to": { "lit": "contact:bea" }, "body": { "ref": "pick" } }
            }
          ]
        }
      },
      "expected": { "result": "accept" },
      "status": "normative"
    },
    {
      "id": "plan.verify.002",
      "spec": [{ "doc": "L3", "version": "0.1", "section": "R11" }],
