          },
          {
            "id": "urn:sidged:capability:message.send",
            "effects": ["egress"],
            "data_classes": ["communications.content"],
            "consequential": true,
            "cost": { "class": "free" }
          }
        ],
        "plan": {
          "v": "0.1",
          "steps": [
            {
              "id": "notes",
              "kind": "call",
              "capability": "urn:sidged:capability:records.read",
              "args": {}
            },
            {
              "id": "send",
              "kind": "call",
              "capability": "urn:sidged:capability:message.send",
              "approval": true,
              "args": { "body": { "ref": "notes" } }
            }
          ]
        }
      },
      "expected": { "result": "refuse" },
      "status": "normative",
      "note": "health.records reaches an egress capability and the default flow policy denies it"
    },
