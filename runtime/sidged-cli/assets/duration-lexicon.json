{
  "v": "0.1",
  "about": "Word forms the timer executor reads in a duration slot (en, de, gsw incl. Bernese, Basel and Zurich forms). A duration is a sum of [number|article] [fraction] unit groups, optionally joined by connectors; fillers (\"a quarter of an hour\") are skipped; anything else is refused. Every form is lowercase and belongs to exactly one entry.",
  "units": {
    "1": ["s", "sec", "secs", "second", "seconds", "sek", "sekunde", "sekunden", "sekundä", "sekündli"],
    "60": ["m", "min", "mins", "minute", "minutes", "minuten", "minutä", "minüt", "minütli", "minüteli"],
    "900": ["viertelstunde", "viertelstunden", "viertelstund", "viertelschtund", "viertustund", "viertustunde", "viertelstündli", "viertustündli"],
    "3600": ["h", "hr", "hrs", "hour", "hours", "std", "stunde", "stunden", "stund", "stundä", "stunda", "schtund", "schtunde", "stündli", "stündeli"],
    "86400": ["d", "day", "days", "tag", "tage", "tagen", "täg", "tääg"]
  },
  "articles": ["a", "an", "e", "ä", "es", "en", "ein", "eine", "einen", "einer", "ere", "nere", "eme", "emne", "ne"],
  "numbers": {
