{
  "description": "System config store (implementation fixtures, not normative spec vectors). core_uid is the uid the Core runs as. reason is a substring of the refusal message.",
  "core_uid": 990,
  "vectors": [
    {
      "id": "minimal-tui",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui"},
      "expected": "accept"
    },
    {
      "id": "local-with-unix-model",
      "config": {"v": "0.1", "mode": "personal", "local": true, "interface": "tui",
                 "model": {"endpoint": "unix:/run/sidged/model.sock", "uid": 993}},
      "expected": "accept"
    },
    {
      "id": "gemini-with-project-and-file-reference",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "static-shell",
                 "provider": {"id": "gemini", "project": "billing-project",
                              "credential": {"file": "/var/lib/sidged/credentials/gemini.key"}},
                 "approval": {"approve_uid": 1001, "non_approver_uids": [1002, 1003]}},
      "expected": "accept"
    },
    {
      "id": "xai-file-reference",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "xai", "credential": {"file": "/var/lib/sidged/credentials/xai.key"}}},
      "expected": "accept"
    },
    {
      "id": "infomaniak-without-credential",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "infomaniak"}},
      "expected": "accept"
    },
    {
      "id": "unknown-top-level-key",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui", "port": 8080},
      "expected": "refuse", "reason": "unknown key"
    },
    {
      "id": "dormant-api-keys-field",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "dormant_api_keys": {"xai": "x"}},
      "expected": "refuse", "reason": "unknown key"
    },
    {
      "id": "unknown-version",
      "config": {"v": "9.9", "mode": "personal", "local": false, "interface": "tui"},
      "expected": "refuse", "reason": "version"
    },
    {
      "id": "swarm-mode",
      "config": {"v": "0.1", "mode": "swarm", "local": false, "interface": "tui"},
      "expected": "refuse", "reason": "swarm"
    },
    {
      "id": "local-string",
      "config": {"v": "0.1", "mode": "personal", "local": "true", "interface": "tui"},
      "expected": "refuse", "reason": "local must be a boolean"
    },
    {
      "id": "local-number",
      "config": {"v": "0.1", "mode": "personal", "local": 1, "interface": "tui"},
      "expected": "refuse", "reason": "local must be a boolean"
    },
    {
      "id": "web-interface",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "web"},
      "expected": "refuse", "reason": "interface"
    },
    {
      "id": "openai-provider",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "openai"}},
      "expected": "refuse", "reason": "not in the 0007 gateway registry"
    },
    {
      "id": "anthropic-provider",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "anthropic"}},
      "expected": "refuse", "reason": "not in the 0007 gateway registry"
    },
    {
      "id": "gemini-without-project",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "gemini"}},
      "expected": "refuse", "reason": "provider.project"
    },
    {
      "id": "gemini-blank-project",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "gemini", "project": "  "}},
      "expected": "refuse", "reason": "provider.project"
    },
    {
      "id": "project-for-xai",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "xai", "project": "p"}},
      "expected": "refuse", "reason": "provider.project"
    },
    {
      "id": "inline-key-in-provider",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "xai", "api_key": "abc"}},
      "expected": "refuse", "reason": "unknown key"
    },
    {
      "id": "credential-relative-path",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "xai", "credential": {"file": "keys/xai.key"}}},
      "expected": "refuse", "reason": "absolute"
    },
    {
      "id": "credential-keychain-not-implemented",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "xai", "credential": {"keychain": "sidged/xai"}}},
      "expected": "refuse", "reason": "credential"
    },
    {
      "id": "secret-in-project",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "gemini", "project": "sk-abcdefghijklmnopqrstuvwx"}},
      "expected": "refuse", "reason": "key material"
    },
    {
      "id": "secret-in-unknown-field",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "note": "NOT-A-KEY-SYNTHETIC-ACCESS-ID"},
      "expected": "refuse", "reason": "key material"
    },
    {
      "id": "pem-in-credential-path",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "provider": {"id": "xai", "credential": {"file": "/-----BEGIN PRIVATE KEY-----"}}},
      "expected": "refuse", "reason": "key material"
    },
    {
      "id": "approver-is-root",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "approval": {"approve_uid": 0, "non_approver_uids": [1002]}},
      "expected": "refuse", "reason": "root"
    },
    {
      "id": "approver-is-core",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "approval": {"approve_uid": 990, "non_approver_uids": [1002]}},
      "expected": "refuse", "reason": "Core uid"
    },
    {
      "id": "approver-in-non-approvers",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "approval": {"approve_uid": 1001, "non_approver_uids": [1001]}},
      "expected": "refuse", "reason": "non-approver"
    },
    {
      "id": "core-in-non-approvers",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "approval": {"approve_uid": 1001, "non_approver_uids": [990]}},
      "expected": "refuse", "reason": "Core uid"
    },
    {
      "id": "empty-non-approvers",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "approval": {"approve_uid": 1001, "non_approver_uids": []}},
      "expected": "refuse", "reason": "non_approver_uids"
    },
    {
      "id": "root-in-non-approvers",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "approval": {"approve_uid": 1001, "non_approver_uids": [0]}},
      "expected": "refuse", "reason": "root"
    },
    {
      "id": "approval-in-local-mode",
      "config": {"v": "0.1", "mode": "personal", "local": true, "interface": "tui",
                 "approval": {"approve_uid": 1001, "non_approver_uids": [1002]}},
      "expected": "refuse", "reason": "local mode"
    },
    {
      "id": "model-without-local",
      "config": {"v": "0.1", "mode": "personal", "local": false, "interface": "tui",
                 "model": {"endpoint": "unix:/run/sidged/model.sock", "uid": 993}},
      "expected": "refuse", "reason": "local mode"
    },
    {
      "id": "model-remote-tcp",
      "config": {"v": "0.1", "mode": "personal", "local": true, "interface": "tui",
                 "model": {"endpoint": "tcp:192.0.2.1:8080"}},
      "expected": "refuse", "reason": "model.endpoint"
    },
    {
      "id": "not-an-object",
      "config": ["v", "0.1"],
      "expected": "refuse", "reason": "object"
    }
  ]
}
