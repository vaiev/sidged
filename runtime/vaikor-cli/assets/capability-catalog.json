[
  {
    "v": "0.1",
    "id": "tag:vaikor.com,2026:capability:worker.fetch",
    "title": "Fetch a public page",
    "description": "Fetch one public https page through the Privacy Gateway; the address leaves the device, so every call needs Trusted UI approval.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://",
          "description": "Public https address of the page."
        }
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "effects": [
      "egress"
    ],
    "data_classes": [
      "query.general"
    ],
    "residency": {
      "tags": [
        "unrestricted"
      ]
    },
    "cost": {
      "class": "free"
    },
    "consequential": true
  },
  {
    "v": "0.1",
    "id": "tag:vaikor.com,2026:capability:workspace.read",
    "title": "Read a workspace file",
    "description": "Read one text file inside the owner's workspace (symlinks and path traversal are refused).",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./ -]*$",
          "description": "Path relative to the workspace; the adapter refuses traversal and symlinks."
        }
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "effects": [
      "read"
    ],
    "data_classes": [
      "documents.text"
    ],
    "residency": {
      "tags": [
        "CH"
      ]
    },
    "cost": {
      "class": "free"
    },
    "consequential": false
  },
  {
    "v": "0.1",
    "id": "tag:vaikor.com,2026:capability:workspace.write",
    "title": "Write a workspace file",
    "description": "Write one text file inside the owner's workspace (symlinks and path traversal are refused).",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "text"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./ -]*$",
          "description": "Path relative to the workspace; the adapter refuses traversal and symlinks."
        },
        "text": {
          "type": "string",
          "maxLength": 1048576,
          "description": "New content of the file."
        }
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      }
    },
    "effects": [
      "write"
    ],
    "data_classes": [
      "documents.text"
    ],
    "residency": {
      "tags": [
        "CH"
      ]
    },
    "cost": {
      "class": "free"
    },
    "consequential": true
  },
